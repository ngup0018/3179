{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 900,
  "height": 500,
  "title": "TEST: SA2 Shapes (debug)",
  "data": {
    "url": "data/abs_sa2_boundaries.geojson",
    "format": { "type": "json", "property": "features" }
  },
  "projection": { "type": "mercator", "center": [134, -25], "scale": 1000, "translate": [450, 250] },
  "layer": [
    {
      "mark": { "type": "geoshape", "fill": "none", "stroke": "#2b7bba", "strokeWidth": 2 },
      "encoding": {
        "tooltip": [
          { "field": "properties.SA2_NAME21", "type": "nominal", "title": "Region" },
          { "field": "properties.SA2_CODE21", "type": "nominal", "title": "SA2 code" }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "(datum.geometry && datum.geometry.type === 'Polygon') ? datum.geometry.coordinates[0][0][0] : null",
          "as": "_debug_long"
        },
        { "calculate": "(datum.geometry && datum.geometry.type === 'Polygon') ? datum.geometry.coordinates[0][0][1] : null", "as": "_debug_lat" }
      ],
      "mark": { "type": "point", "filled": true, "size": 80, "color": "#d62728" },
      "encoding": {
        "longitude": { "field": "_debug_long", "type": "quantitative" },
        "latitude": { "field": "_debug_lat", "type": "quantitative" },
        "tooltip": [
          { "field": "properties.SA2_NAME21", "type": "nominal", "title": "Region (centroid)" }
        ]
      }
    }
  ]
}